--========================================================--
-- MINE SATU CRYSTAL
--========================================================--

local function mineOneCrystal()
    if not isAlive() then return false end

    local prompt = findCrystal()
    if not prompt then return false end

    local position = getPromptPosition(prompt)
    if not position then return false end

    local character = Player.Character
    if not character then return false end
    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then return false end

    local fromRoot = root.Position - position
    fromRoot = Vector3.new(fromRoot.X, 0, fromRoot.Z)
    if fromRoot.Magnitude < 0.1 then
        fromRoot = Vector3.new(0, 0, -1)
    end
    fromRoot = fromRoot.Unit * 4

    root.CFrame = CFrame.new(position + fromRoot + Vector3.new(0, 3, 0))
    task.wait(PromptDelay)

    if not isAlive() then return false end

    if firePrompt(prompt) then
        mineCount = mineCount + 1
        updateStatus()
        return true
    end
    return false
end

--========================================================--
-- PROSES SATU AREA (mirip versi lama, sekarang pakai MINE_PACE)
--========================================================--

local function processArea(areaIndex, position)
    currentArea = areaIndex
    updateStatus()
    setStatus(("MINING %s..."):format(areaName[areaIndex]), Color3.fromRGB(40, 150, 70))

    if position then
        if not teleportTo(position) then
            warn("[Mine] Gagal teleport ke " .. areaName[areaIndex])
            return
        end
        task.wait(TeleportDelay)
    end

    -- Grace period: tunggu crystal pertama muncul (maks AREA_GRACE_TIMEOUT detik)
    local graceStart = tick()
    while tick() - graceStart < AREA_GRACE_TIMEOUT do
        if findCrystal() then
            break
        end
        task.wait(0.3)
    end

    -- Mining loop: mine sampai crystal benar-benar habis
    local failStreak = 0
    while true do
        if not isAlive() then
            task.wait(1)
        else
            local ok = mineOneCrystal()
            if ok then
                failStreak = 0
                task.wait(MINE_PACE)   -- <<< jeda santai antar mine yang berhasil
            else
                failStreak = failStreak + 1
                if failStreak >= AREA_EMPTY_STREAK then
                    break
                end
                task.wait(AREA_EMPTY_WAIT)
            end
        end
    end

    print(("[Mine] %s selesai. Total mine: %d"):format(areaName[areaIndex], mineCount))
end

--========================================================--
-- MAIN FLOW: C1 → C2 → HOP
--========================================================--

local function mainLoop()
    while true do
        processArea(1, CrystalDepths1Position)
        processArea(2, CrystalDepths2Position)

        setStatus("HOPPING SERVER...", Color3.fromRGB(180, 100, 40))
        showPopup(("Semua area habis, hop dalam %ds..."):format(HopDelay),
            Color3.fromRGB(180, 100, 40))
        task.wait(HopDelay)

        serverHop()

        local waited = 0
        while hopRunning and waited < 30 do
            task.wait(1)
            waited = waited + 1
        end

        task.wait(2)
    end
end

