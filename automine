local function teleportTo(position)
    local character = Player.Character
    if not character then return false end
    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then return false end
    root.CFrame = CFrame.new(position)
    return true
end

local function isAlive()
    local character = Player.Character
    if not character then return false end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return false end
    return character:FindFirstChild("HumanoidRootPart") ~= nil
end

--========================================================--
-- CRYSTAL PROMPT DETECTION
--========================================================--

local BlacklistWords = {
    "npc", "craft", "table", "shop",
    "sell", "buy", "talk", "dialog",
    "examine", "miner", "minecart",
    "miningtable", "crafting",
}

local function containsWord(text, word)
    return string.find(text, word, 1, true) ~= nil
end

local function isCrystalPrompt(prompt)
    if not prompt:IsA("ProximityPrompt") then return false end

    local model = prompt:FindFirstAncestorOfClass("Model")
    if model and model:FindFirstChildOfClass("Humanoid") then
        return false
    end

    local action = string.lower(prompt.ActionText or "")
    local object = string.lower(prompt.ObjectText or "")

    for _, word in ipairs(BlacklistWords) do
        if containsWord(action, word) or containsWord(object, word) then
            return false
        end
    end

    local part = prompt:FindFirstAncestorWhichIsA("BasePart")
    local partName = part and string.lower(part.Name) or ""

    return containsWord(action, "crystal")
        or containsWord(object, "crystal")
        or containsWord(partName, "crystal")
end

local function getPromptPosition(prompt)
    local parent = prompt.Parent
    if parent:IsA("BasePart") then return parent.Position end
    if parent:IsA("Attachment") then return parent.WorldPosition end
    local part = prompt:FindFirstAncestorWhichIsA("BasePart")
    if part then return part.Position end
    return nil
end

local function findCrystal()
    local character = Player.Character
    if not character then return nil end
    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then return nil end

    local closest, closestDistance = nil, math.huge

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt")
            and obj.Enabled
            and isCrystalPrompt(obj) then

            local position = getPromptPosition(obj)
            if position then
                local distance = (root.Position - position).Magnitude
                if distance < closestDistance
                    and distance <= MaxCrystalDistance then
                    closestDistance = distance
                    closest = obj
                end
            end
        end
    end
    return closest
end

local function firePrompt(prompt)
    if typeof(fireproximityprompt) == "function" then
        pcall(function() fireproximityprompt(prompt) end)
        return true
    end
    local ok = pcall(function()
        local oldHold = prompt.HoldDuration
        prompt.HoldDuration = 0
        prompt:InputHoldBegin()
        task.wait(0.05)
        prompt:InputHoldEnd()
        prompt.HoldDuration = oldHold
    end)
    return ok
end

--========================================================--
-- SERVER HOP
--========================================================--

local hopCandidates = {}
local doneCalled    = false
local failedConn

local function getServers()
    local url = ("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100&excludeFullGames=true"):format(PLACE_ID)

    local ok, body = pcall(function()
        if httpRequest then
            return httpRequest({ Url = url, Method = "GET" }).Body
        end
        return game:HttpGet(url)
    end)

    if not ok or not body then return nil end

    local okDecode, decoded = pcall(function()
        return HttpService:JSONDecode(body)
    end)

    if not okDecode or not decoded then return nil end
    if decoded.errors then return nil end
    return decoded.data
end

local function finishHop()
    doneCalled = true
    hopRunning = false
    if failedConn then
        failedConn:Disconnect()
        failedConn = nil
    end
end

local tryNextHop
tryNextHop = function()
    if doneCalled then return end

    if hopAttempts >= HOP_MAX_ATTEMPTS then
        warn("[AutoHop] Batas percobaan tercapai")
        finishHop()
        return
    end

    local target = table.remove(hopCandidates)
    if not target then
        warn("[AutoHop] Tidak ada server lain")
        finishHop()
        return
    end

    hopAttempts = hopAttempts + 1
    local myAttempt = hopAttempts
    updateStatus()

    print(("[AutoHop] Percobaan %d/%d -> %s"):format(myAttempt, HOP_MAX_ATTEMPTS, target))

    local ok, err = pcall(function()
        TeleportService:TeleportToPlaceInstance(PLACE_ID, target, Player)
    end)

    if not ok then
        warn("[AutoHop] Teleport error:", err)
        task.wait(1)
        return tryNextHop()
    end

    task.delay(HOP_FAIL_TIMEOUT, function()
        if doneCalled or hopAttempts ~= myAttempt then return end
        warn(("[AutoHop] Timeout %ds, coba server lain..."):format(HOP_FAIL_TIMEOUT))
        tryNextHop()
    end)
end

local function serverHop()
    if hopRunning then return end
    hopRunning    = true
    hopAttempts   = 0
    doneCalled    = false
    hopCandidates = {}
    updateStatus()

    local servers = getServers()
    if not servers then finishHop(); return end

    for _, server in ipairs(servers) do
        if server.id ~= CURRENT_JOB
            and server.playing < server.maxPlayers - 1 then
            table.insert(hopCandidates, server.id)
        end
    end

    if #hopCandidates == 0 then
        warn("[AutoHop] Tidak ada server lain")
        finishHop()
        return
    end

    for i = #hopCandidates, 2, -1 do
        local j = math.random(1, i)
        hopCandidates[i], hopCandidates[j] = hopCandidates[j], hopCandidates[i]
    end

    failedConn = TeleportService.TeleportInitFailed:Connect(function(player)
        if player ~= Player or doneCalled then return end
        task.wait(1)
        tryNextHop()
    end)

    tryNextHop()
end

